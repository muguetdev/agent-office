    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Waiting on me", "short_name": "Waiting", "url": "/lite?filter=waiting", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "New task", "short_name": "New task", "url": "/lite?new=1", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
