#!/usr/bin/env python3
"""ce-machines-ssh: forced command for office SSH keys.

authorized_keys runs this as `ce-machines-ssh <office>` for every session
opened with an office key. The client's requested command arrives in
$SSH_ORIGINAL_COMMAND; it must be `ce-machines <subcommand> [args...]`
(the leading `ce-machines` may be omitted) with an office-level subcommand:
ping, status, list, create, delete, exec, put, get. exec, put and get act
inside the office's own machines only; put reads the file from the session's
stdin and get writes it to its stdout.

The command line is split with shlex (POSIX quoting rules) into an argument
vector and handed straight to ce-machines' main() with the office name, which
scopes every command to that office's machines. Nothing is ever run through a
shell, and callers cannot pass --office themselves.
"""

import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import sys

CE_MACHINES = os.environ.get("CE_MACHINES_BIN", "/usr/local/bin/ce-machines")
OFFICE_RE = re.compile(r"^[a-z0-9][a-z0-9-]{0,39}$")
MAX_COMMAND = 1024
# exec carries a whole command line (base64 in --command-b64): room for it,
# within what one environment variable may hold.
MAX_EXEC_COMMAND = 120000
ALLOWED = ("ping", "status", "list", "create", "delete", "exec", "put", "get")


def fail(msg):
    sys.stdout.write(json.dumps({"error": msg}) + "\n")
    sys.exit(1)


def main():
    if len(sys.argv) != 2 or not OFFICE_RE.match(sys.argv[1]):
        fail("server misconfigured: bad office name in authorized_keys")
    office = sys.argv[1]

    raw = os.environ.get("SSH_ORIGINAL_COMMAND", "")
    if not raw.strip():
        fail("interactive sessions are not allowed; run: ce-machines <command>")
    first = raw.split(None, 2)
    exec_like = "exec" in first[:2]
    if len(raw) > (MAX_EXEC_COMMAND if exec_like else MAX_COMMAND) or any(ord(ch) < 32 for ch in raw):
        fail("command rejected")
    try:
        argv = shlex.split(raw, posix=True)
    except ValueError:
        fail("command rejected: unbalanced quotes")
    if argv and argv[0] in ("ce-machines", CE_MACHINES):
        argv = argv[1:]
    if not argv or argv[0] not in ALLOWED:
        fail("command not allowed")
    # Options end at exec's "--"; what follows is the command line itself.
    options = argv[:argv.index("--")] if "--" in argv else argv
    if "--office" in options:
        fail("--office is set by the server")

    loader = importlib.machinery.SourceFileLoader("ce_machines", CE_MACHINES)
    spec = importlib.util.spec_from_loader("ce_machines", loader)
    module = importlib.util.module_from_spec(spec)
    loader.exec_module(module)
    module.main(argv, office=office)


if __name__ == "__main__":
    main()
